#!/bin/sh
GIT_DIR=$(git rev-parse --git-dir)
mkdir -p "$GIT_DIR/tmp"

# Restore a temporary scratch un-ignore so it cannot be committed.
# Commented ignore: #/scratch (flexnet), # scratch, #scratch/
# Negation: !scratch, !/scratch (rewrite back to the ignore, do not delete)
if grep -qE '^#[[:space:]]*/?scratch/?[[:space:]]*$|^![[:space:]]*/?scratch/?[[:space:]]*$' .gitignore 2>/dev/null; then
  cp .gitignore "$GIT_DIR/tmp/.gitignore.bak"
  sed -i '' -E 's|^#[[:space:]]*(/?scratch/?)[[:space:]]*$|\1|' .gitignore
  sed -i '' -E 's|^![[:space:]]*(/?scratch/?)[[:space:]]*$|\1|' .gitignore
  git add .gitignore
fi

scratch_files=$(git diff --cached --name-only | grep '^scratch/')
if [ -n "$scratch_files" ]; then
  echo "$scratch_files" | xargs git reset HEAD --
fi

exec "$(dirname "$0")/run-repo-hook" "$0" "$@"
